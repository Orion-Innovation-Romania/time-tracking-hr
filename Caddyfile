# TTAH reverse proxy. Single entrypoint; internal TLS (self-signed) for VPN use.
# Set SITE_ADDRESS in .env to the LAN IP or hostname clients use in the browser.
#
# When clients connect by raw IP, browsers omit SNI. Inside Docker the TCP
# destination looks like the container IP (172.x), so default_sni tells Caddy
# which certificate to serve.
{
	default_sni {$SITE_ADDRESS}
}

{$SITE_ADDRESS} {
	encode gzip zstd

	# API -> NestJS (path prefix /api is preserved and expected by the API)
	handle /api/* {
		reverse_proxy api:4000
	}

	# Everything else -> Next.js web app
	handle {
		reverse_proxy web:3000
	}

	tls internal

	header {
		# Security headers (defense in depth; app also sets its own)
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
