# ============================================================================
# TTAH Platform - environment configuration
# Copy to .env and adjust. In Docker Compose, DATABASE_URL host is "postgres".
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=ttah
POSTGRES_PASSWORD=change_me_use_a_strong_password
POSTGRES_DB=ttah

# For local dev (API running on host): use localhost.
# For Docker Compose (API in container): host is "postgres".
DATABASE_URL=postgresql://ttah:change_me_use_a_strong_password@localhost:5432/ttah?schema=public

# --- API ---
API_PORT=4000
NODE_ENV=development
TZ=Europe/Bucharest

# Secrets - generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=604800      # seconds (7 days)

# Comma-separated allowed origins for CORS (the web app origin)
CORS_ORIGIN=http://localhost:3000

# Path to the user accounts config (source of truth for accounts)
USERS_CONFIG_PATH=./config/users.yml

# Temp dir for uploaded PDFs (deleted right after parsing)
UPLOAD_TMP_DIR=./.uploads

# Structured data retention in months (0 = keep forever)
DATA_RETENTION_MONTHS=24

# Cookies: set true when served over HTTPS (production/Caddy)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Web (Next.js) ---
# Browser -> API base. Same-origin "/api" in all envs (Next rewrites in dev, Caddy in prod).
NEXT_PUBLIC_API_BASE_URL=/api
# Server-side (SSR) -> API base. Local: http://localhost:4000 ; Docker: http://api:4000
API_INTERNAL_URL=http://localhost:4000

# --- Mail (Microsoft Graph sendMail) ---
# Put the client secret in .env only. Never commit it.
GRAPH_AUTHORITY=https://login.microsoftonline.com/adbbbd82-76e5-4952-8531-3cc59f3c1fdd/
GRAPH_CLIENT_ID=b903c612-e24c-4dfa-a9d2-5e907f492460
GRAPH_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default
MAIL_SENDER_MAILBOX=dpd-rou.inventory-smb@orioninc.com
MAIL_FROM_ADDRESS=dpd-rou.inventory.no-reply@orioninc.com
MAIL_FROM_NAME=DPD-ROU-Hr-Recruitment

# --- Deployment (Caddy) ---
# Hostname or IP the platform is served on (internal/VPN).
SITE_ADDRESS=:443
